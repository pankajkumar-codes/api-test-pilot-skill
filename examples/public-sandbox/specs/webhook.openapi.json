      }
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "data": {
           "type": "array",
           "items": {
            "type": "object"
           }
          },
          "total": {
           "type": "integer"
          }
         },
         "required": [
          "data"
         ]
        }
       }
      }
     }
    }
   }
  }
 }
}